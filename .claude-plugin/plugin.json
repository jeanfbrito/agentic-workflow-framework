{
  "name": "agentic-workflow-framework",
  "version": "0.3.0",
  "description": "Multi-agent orchestration conventions: orchestrator mode, 10 subagent roles, slash commands, hooks.",
  "author": { "name": "Jean Brito", "url": "https://github.com/jeanfbrito" },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-agentic-context.sh\"",
            "timeout": 5,
            "statusMessage": "Loading agentic framework conventions..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-scan.sh\"",
            "timeout": 5,
            "statusMessage": "Checking agentic session state..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.sh\"",
            "timeout": 5,
            "statusMessage": "Snapshotting in-flight cards before compaction..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-ledger-audit.sh\"",
            "timeout": 5,
            "statusMessage": "Ledger hygiene check..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator.sh\"",
            "timeout": 5,
            "statusMessage": "Orchestrator check..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/allow-workflow-paths.sh\"",
            "timeout": 5,
            "statusMessage": "Framework path check..."
          }
        ]
      }
    ]
  }
}
